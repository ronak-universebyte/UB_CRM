{
  "name": "universebyte-crm",
  "version": "1.0.0",
  "private": true,
  "description": "UniverseByte CRM – IT Training Enquiry and Lead Management System",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue.bold,green.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspace=backend",
    "smoke:test": "npm run smoke:test --workspace=backend",
    "db:init": "npm run db:init --workspace=backend",
    "seed:admin": "npm run seed:admin --workspace=backend",
    "clean": "npm run clean --workspaces --if-present"
  },
  "keywords": [
    "crm",
    "it-training",
    "lead-management",
    "universebyte",
    "react",
    "express",
    "mongodb"
  ],
  "author": "UniverseByte – Technology Redefined",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
