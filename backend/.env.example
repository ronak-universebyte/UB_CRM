# ==============================================================================
# UniverseByte CRM - Backend Environment Variables
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/universebyte_crm?retryWrites=true&w=majority

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins & Frontend Domain
# For local dev: http://localhost:5173
# For Render production: https://universebyte-crm-frontend.onrender.com or https://crm.universebyte.com
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=https://universebyte-crm-frontend.onrender.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Initial Super Admin (For initial seed command only, never commit actual creds)
INITIAL_SUPER_ADMIN_NAME=Super Admin
INITIAL_SUPER_ADMIN_EMAIL=admin@universebyte.com
INITIAL_SUPER_ADMIN_PASSWORD=ChangeMeInProduction!123

# WhatsApp Official Meta Cloud API (Optional - for automated templates & webhooks)
# When omitted, CRM operates in robust Manual Click-to-WhatsApp mode.
# Accepts both META_* and WHATSAPP_* aliases:
META_ACCESS_TOKEN=EAAB...
META_PHONE_NUMBER_ID=100123456789012
META_WABA_ID=200123456789012
META_WEBHOOK_VERIFY_TOKEN=universebyte_webhook_verify_token_2026
META_APP_SECRET=your_meta_app_secret
WHATSAPP_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=100123456789012
WHATSAPP_BUSINESS_ACCOUNT_ID=200123456789012
WHATSAPP_WEBHOOK_VERIFY_TOKEN=universebyte_webhook_verify_token_2026
WHATSAPP_API_VERSION=v21.0

# Groq AI Assistant (Optional - Llama 3.3 70B via Groq API)
# Get a free key at: https://console.groq.com/keys
# When omitted, CRM operates in intelligent local heuristic rule mode.
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=15000



